# JamFlow Environment Configuration

# Optional: URL of your persistent Socket.IO server (Render, Railway, Fly.io, or VPS)
# When deploying the frontend on Vercel, set this to your backend server URL (e.g., https://your-jamflow-backend.onrender.com)
# In local development, you can leave this empty to connect to the local server automatically.
NEXT_PUBLIC_SOCKET_URL=

# Server Port (defaults to 3000)
PORT=3000
